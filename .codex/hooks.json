{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.codex/hooks/deny-dangerous-shell.sh",
            "timeout": 30,
            "statusMessage": "Checking shell safety policy"
          }
        ]
      }
    ]
  }
}
