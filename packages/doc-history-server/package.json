{
  "name": "@takazudo/zudo-doc-history-server",
  "version": "4.4.9",
  "type": "module",
  "description": "Standalone doc git-history service for zudo-doc — HTTP server + CLI batch generator. Decouples expensive `git log --follow` calls from the main build pipeline.",
  "license": "MIT",
  "author": "Takeshi Takatsudo",
  "homepage": "https://zudo-doc.takazudomodular.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zudolab/zudo-doc.git",
    "directory": "packages/doc-history-server"
  },
  "bugs": {
    "url": "https://github.com/zudolab/zudo-doc/issues"
  },
  "keywords": [
    "zudo-doc",
    "documentation",
    "git-history",
    "mdx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "doc-history-server": "./dist/index.js",
    "doc-history-generate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./git-history": {
      "types": "./dist/git-history.d.ts",
      "default": "./dist/git-history.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./concurrency": {
      "types": "./dist/concurrency.d.ts",
      "default": "./dist/concurrency.js"
    },
    "./exclude": {
      "types": "./dist/exclude.d.ts",
      "default": "./dist/exclude.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/git-history.ts src/types.ts src/concurrency.ts src/exclude.ts --format esm --dts",
    "dev": "tsx src/index.ts",
    "generate": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup src/index.ts src/cli.ts src/git-history.ts src/types.ts src/concurrency.ts src/exclude.ts --format esm --dts --silent"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
