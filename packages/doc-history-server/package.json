{
  "name": "@zudo-doc/doc-history-server",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "doc-history-server": "./dist/index.js",
    "doc-history-generate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./git-history": {
      "types": "./dist/git-history.d.ts",
      "default": "./dist/git-history.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/git-history.ts src/types.ts --format esm --dts",
    "dev": "tsx src/index.ts",
    "generate": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup src/index.ts src/cli.ts src/git-history.ts src/types.ts --format esm --dts --silent"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
