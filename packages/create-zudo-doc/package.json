{
  "name": "create-zudo-doc",
  "version": "12.0.1",
  "description": "Create a new zudo-doc documentation site",
  "license": "MIT",
  "author": "Takeshi Takatsudo",
  "homepage": "https://zudo-doc.takazudomodular.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zudolab/zudo-doc.git",
    "directory": "packages/create-zudo-doc"
  },
  "bugs": {
    "url": "https://github.com/zudolab/zudo-doc/issues"
  },
  "keywords": [
    "documentation",
    "zfb",
    "mdx",
    "scaffold",
    "create",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "create-zudo-doc": "bin/create-zudo-doc.js"
  },
  "main": "./dist/api.js",
  "exports": {
    ".": "./dist/api.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "!dist/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "check:publish-contract": "pnpm build && pnpm test",
    "prepublishOnly": "pnpm check:publish-contract"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "fs-extra": "^11.4.1",
    "minimist": "^1.2.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
