{
  "name": "create-zudo-doc",
  "version": "3.3.0",
  "description": "Create a new zudo-doc documentation site",
  "license": "MIT",
  "author": "Takeshi Takatsudo",
  "homepage": "https://zudo-doc.takazudomodular.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zudolab/zudo-doc.git",
    "directory": "packages/create-zudo-doc"
  },
  "bugs": {
    "url": "https://github.com/zudolab/zudo-doc/issues"
  },
  "keywords": [
    "documentation",
    "zfb",
    "mdx",
    "scaffold",
    "create",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "create-zudo-doc": "bin/create-zudo-doc.js"
  },
  "main": "./dist/api.js",
  "exports": {
    ".": "./dist/api.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "!dist/__tests__"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "fs-extra": "^11.3.0",
    "minimist": "^1.2.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.0.0",
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
