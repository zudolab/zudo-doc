    "url": "https://github.com/zudolab/zudo-doc/issues"
  },
  "keywords": [
    "zudo-doc",
    "documentation",
    "framework",
    "mdx",
    "preact",
    "zfb"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
