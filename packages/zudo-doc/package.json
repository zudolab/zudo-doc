  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsup",
    "dev": "tsup --watch",
    "prepare": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsup --silent",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "preact": "^10.29.1",
    "@takazudo/zfb": "^0.1.0-next.31",
    "@takazudo/zfb-runtime": "^0.1.0-next.31",
    "@takazudo/zudo-doc-history-server": "workspace:^",
