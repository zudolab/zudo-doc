# .chrome-bindings-fixture-drift-allowlist
#
# Replacement entries for scripts/check-chrome-bindings-fixture-drift.mjs.
# The guard's invariant is root-line PRESERVATION (ordered subsequence): every
# normalized src/<name>.<ext> line must still appear, in order, in the paired
# e2e/fixtures/<fixture>/src/<name>.fixture.<ext> file. An entry here covers a
# root line the fixture legitimately REPLACES instead of copying verbatim.
#
# Format: one entry per line —
#   <fixture>|<exact trimmed root line>|<exact trimmed replacement line> # reason: <why>
# In a data field, write a literal pipe as \|; only unescaped pipes separate
# fields. Every other backslash is literal; there is no \\ escape. Therefore a
# field value containing the literal two-character sequence \| is inexpressible.
# Comments: lines starting with # are ignored. Blank lines are ignored.
# Exact-match only (no globs, no wildcards). Every entry needs a # reason:.

# hostpanel/src/chrome-bindings.fixture.tsx widens the core type import to
# also pull in Description for its extra BodyEndIslandsWithHostPanel wrapper;
# JSX now comes from the separate jsx-runtime type import (#4310, #4437).
hostpanel|import type { Child } from "@takazudo/zfb/zudo-react";|import type { Child, Description } from "@takazudo/zfb/zudo-react"; # reason: fixture's BodyEndIslandsWithHostPanel wrapper needs Description alongside Child

# hostpanel/src/chrome-bindings.fixture.tsx expands the single-line
# _body-end-islands import into a multi-line import that also pulls in the
# BodyEndIslandsProps type used by its BodyEndIslandsWithHostPanel wrapper
# (#4310); the named BodyEndIslands import itself still appears verbatim as
# one line of that multi-line statement.
hostpanel|import { BodyEndIslands as BodyEndIslandsSeam } from "../pages/lib/_body-end-islands";|BodyEndIslands as BodyEndIslandsSeam, # reason: fixture splits this into a multi-line import to also pull in the BodyEndIslandsProps type

# hostpanel/src/chrome-bindings.fixture.tsx wires its own
# BodyEndIslandsWithHostPanel wrapper (which mounts the host design-token-panel
# island) in place of the plain seam re-export (#4310).
hostpanel|BodyEndIslands: BodyEndIslandsSeam,|BodyEndIslands: BodyEndIslandsWithHostPanel, # reason: fixture mounts the host-owned design-token-panel island via its own wrapper
