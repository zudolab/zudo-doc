auto-install-peers=true

# pnpm's provenance-downgrade guard. Valid values: `off` (default) and
# `no-downgrade` (added in pnpm 10.21.0); enforced only during dependency
# *resolution*. Tightened from the prior non-standard `trust-policy=any`
# (pnpm silently ignored that as `off`, i.e. no protection — issue #2039).
# Verified clean: a forced full re-resolution (`rm pnpm-lock.yaml && pnpm i
# --lockfile-only`) of the current tree passes under no-downgrade on pnpm
# 10.30.3. Note it is inert under `--frozen-lockfile` (CI + routine installs
# skip resolution). If a future/stricter pnpm flags a downgraded transitive
# dep, exempt it via `trustPolicyExclude` — the likeliest candidate here is
# undici-types@6.21.0 (a sibling repo had to exclude it under pnpm 11).
trust-policy=no-downgrade

# zfb-adapter-cloudflare's emitted bundle resolves miniflare via filesystem
# traversal from the bundle path / workspace root, not via Node require
# resolution. With pnpm's strict isolation default, miniflare lives only
# under node_modules/.pnpm/, so the bundle cannot find it during the
# `paths()` evaluation step of `zfb build`. Hoist miniflare (and its
# closest neighbours that the runtime probes) to the top-level node_modules
# so the bundle resolution succeeds.
public-hoist-pattern[]=miniflare

# semver@6.3.1 (pulled in transitively by @preact/preset-vite's @prefresh/vite
# -> @babel/core, added for packages/zudo-doc-online, epic #3327) trips the
# `no-downgrade` guard above as a known pnpm false positive (pnpm issue
# #10202): the trust check compares across major version LINES rather than
# within one, so semver@7.x's newer provenance makes semver@6.3.1 look
# downgraded even though they're unrelated branches. Exempt it per the
# documented escape hatch above instead of loosening `trust-policy` itself.
trust-policy-exclude[]=semver@6.3.1
