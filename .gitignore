node_modules/
dist/
# eject/ is a build artifact generated by packages/zudo-doc/scripts/copy-eject-sources.mjs
# (tsup onSuccess); it ships in the npm tarball via files[] but is not tracked in git
# (same policy as dist/).
packages/zudo-doc/eject/
# routes-src/ is a build artifact generated by packages/zudo-doc/scripts/copy-routes-src.mjs
# (tsup onSuccess); it ships in the npm tarball via files[] but is not tracked in git
# (same policy as dist/ and eject/).
packages/zudo-doc/routes-src/
# virtual-modules.d.ts is a build artifact generated by
# packages/zudo-doc/scripts/copy-virtual-modules.mjs (tsup onSuccess) from
# src/routes/_virtual.d.ts; it ships in the npm tarball via files[] but is
# not tracked in git (same policy as routes-src/).
packages/zudo-doc/virtual-modules.d.ts
.zfb/
# W6A — un-ignore the create-zudo-doc seed file so it ships in the
# generated tarball. .zfb/ stays gitignored everywhere else; the seed
# lets a freshly-scaffolded project resolve the `#doc-history-meta`
# alias even without docHistory enabled (it is overwritten at build
# time by the doc-history prebuild step).
!packages/create-zudo-doc/templates/base/.zfb/
!packages/create-zudo-doc/templates/base/.zfb/doc-history-meta.json
.zfb-build/
worktrees/
__inbox/
.env
.env.local
.env.production

# Generated Claude Code resource docs
src/content/docs/claude/
src/content/docs/claude-md/
src/content/docs/claude-commands/
src/content/docs/claude-skills/
src/content/docs/claude-agents/
test-results/
.playwright-cli/

# tags:suggest --batch output (developer-opt-in, not committed)
.tag-suggestions.jsonl

# contrast:audit output (JSON report + optional HTML preview, not committed)
contrast-audit-out/

# theme-a11y:audit output (per-pack rendered contrast report, not committed)
theme-a11y-audit-out/

# Generated zudo-doc-wisdom skill (machine-specific symlinks)
.claude/skills/zudo-doc-wisdom/SKILL.md
.claude/skills/zudo-doc-wisdom/docs
.claude/skills/zudo-doc-wisdom/docs-ja
.claude/skills/zudo-doc-wisdom/skill-writing-rules.md
.claude/skills/zudo-doc-wisdom/skill-design-system.md
.claude/skills/zudo-doc-wisdom/skill-navigation-design.md
.codex/skills/zudo-doc-wisdom/SKILL.md
.codex/skills/zudo-doc-wisdom/docs
.codex/skills/zudo-doc-wisdom/docs-ja

# E2E fixture materialized sources, dependency symlinks, and generated files
# (zfb topology — see e2e/setup-fixtures.sh). At the fixture root, pages/ and
# plugins/ are copied first-party sources; packages/ and node_modules/ are
# dependency symlinks.
e2e/fixtures/*/node_modules
e2e/fixtures/*/pages
e2e/fixtures/*/plugins
e2e/fixtures/*/packages
# Copied first-party src/* dirs (config/ and content/ have separate rules below)
e2e/fixtures/*/src/components
e2e/fixtures/*/src/lib
e2e/fixtures/*/src/styles
e2e/fixtures/*/src/types
e2e/fixtures/*/src/utils
# Copied configs (regenerated by setup-fixtures.sh)
e2e/fixtures/*/zfb.config.ts
e2e/fixtures/*/tsconfig.json
# Copied single src/ file — the chromeBindingsModule target (minimal-scaffold
# cutover, epic zudolab/zudo-doc#2651, Wave 7 #2663)
e2e/fixtures/*/src/chrome-bindings.tsx
# setup-fixtures.sh copies every src/config/*.ts|*.tsx from the repo root
# EXCEPT settings.ts, which each fixture owns and commits. Glob-ignore the
# copies so a new root config (e.g. design-token-panel-config.ts,
# design-tokens-manifest.ts) doesn't need a new line here each time.
e2e/fixtures/*/src/config/*
!e2e/fixtures/*/src/config/settings.ts
# Build artefacts and history seed
e2e/fixtures/*/.zfb
e2e/fixtures/*/dist
# Per-fixture pnpm-exec gate (generated by setup-fixtures.sh)
e2e/fixtures/*/package.json
# Per-fixture Pages config so `zfb preview` doesn't climb to the root Workers
# config (generated by setup-fixtures.sh)
e2e/fixtures/*/wrangler.toml
# Public dir: fixture-specific entries are kept in git; copied root mirrors are
# not. These mirror the entries in the repo-root public/ (img, favicon.svg);
# add a line if a new root public/ entry is introduced.
e2e/fixtures/*/public/img
e2e/fixtures/*/public/favicon.ico
e2e/fixtures/*/public/favicon.svg
e2e/fixtures/*/public/favicon-16x16.png
e2e/fixtures/*/public/favicon-32x32.png

# migration-check harness workspace (throwaway build artifacts)
.l-zfb-migration-check/

# Per-fixture build-freshness marker (written by setup-fixtures.sh after each
# successful build; used to skip rebuilds when inputs are unchanged).
e2e/fixtures/*/.build-marker.sha256

# wrangler dev/preview state (zfb's preview server hands off to wrangler;
# its on-disk cache lands here per fixture)
.wrangler/
e2e/fixtures/*/.wrangler/
.claude/scheduled_tasks.lock
